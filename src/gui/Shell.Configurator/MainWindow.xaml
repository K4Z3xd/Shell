                                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="+ Add Item" Style="{StaticResource AcrylicPrimaryButtonStyle}" Command="{Binding AddCustomItemCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Duplicate" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding DuplicateCustomItemCommand}" Margin="0,0,8,0"/>
                                    <Button Content="Delete" Style="{StaticResource AcrylicDangerButtonStyle}" Command="{Binding RemoveCustomItemCommand}"/>
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Items List -->
                                <Border Grid.Column="0" Style="{StaticResource AcrylicCardStyle}" Padding="8" MinHeight="380">
                                    <Grid>
                                        <ListBox ItemsSource="{Binding Config.CustomItems}"
                                                 SelectedItem="{Binding SelectedCustomItem}"
                                                 Background="Transparent"
                                                 BorderThickness="0">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="8,7"/>
                                                    <Setter Property="Margin" Value="0,0,0,4"/>
                                                    <Setter Property="Cursor" Value="Hand"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd" CornerRadius="7" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubCardBrush}"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                            <TextBlock Text="{Binding ContextType, StringFormat=Context: {0}}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                        <CheckBox HorizontalAlignment="Right" Style="{StaticResource AcrylicToggleSwitchStyle}" IsChecked="{Binding Enabled}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <TextBlock Text="No custom items yet.&#x0a;Click '+ Add Item' to create one."
                                                   TextAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   Visibility="{Binding HasCustomItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </Grid>
                                </Border>

                                <!-- Item Editor -->
                                <Border Grid.Column="2" Style="{StaticResource AcrylicCardStyle}" MinHeight="380">
                                    <Grid>
                                        <StackPanel Visibility="{Binding SelectedCustomItem, Converter={StaticResource NullToCollapsedConverter}}">
                                            <TextBlock Text="Item Properties" Style="{StaticResource SectionHeadingStyle}"/>

                                            <Grid Margin="0,4,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Title" Style="{StaticResource SettingLabelStyle}"/>
                                                    <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0"
                                                             Text="{Binding SelectedCustomItem.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Context Type" Style="{StaticResource SettingLabelStyle}"/>
                                                    <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0"
                                                              ItemsSource="{Binding ContextTypeOptions}"
                                                              SelectedItem="{Binding SelectedCustomItem.ContextType}"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="160"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Submenu Group (optional)" Style="{StaticResource SettingLabelStyle}"/>
                                                    <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0"
                                                             Text="{Binding SelectedCustomItem.Submenu, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Leave blank to place at root level, or type a submenu name"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Separator" Style="{StaticResource SettingLabelStyle}"/>
                                                    <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0"
                                                              ItemsSource="{Binding SeparatorOptions}"
                                                              SelectedItem="{Binding SelectedCustomItem.Separator}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Command (executable or URL)" Style="{StaticResource SettingLabelStyle}"/>
                                            <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,10"
                                                     Text="{Binding SelectedCustomItem.Command, UpdateSourceTrigger=PropertyChanged}"/>

                                            <TextBlock Text="Arguments" Style="{StaticResource SettingLabelStyle}"/>
                                            <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,10"
                                                     Text="{Binding SelectedCustomItem.Arguments, UpdateSourceTrigger=PropertyChanged}"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Icon (glyph like \uE10A, icon.copy, or path)" Style="{StaticResource SettingLabelStyle}"/>
                                                    <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0"
                                                             Text="{Binding SelectedCustomItem.Icon, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>
                                                <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                                          Style="{StaticResource AcrylicToggleSwitchStyle}"
                                                          Content="Run as Admin"
                                                          IsChecked="{Binding SelectedCustomItem.RunAsAdmin}"/>
                                            </Grid>
                                        </StackPanel>

                                        <TextBlock Text="Select a custom item on the left to edit its properties."
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedCustomItem}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- ==================== PAGE 10: NSS PREVIEW & TOOLS ==================== -->
                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Preview}">
                            <TextBlock Text="Live .NSS Preview &amp; Shell Tools" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Inspect the exact Nilesoft Shell script generated by your choices and manage the Shell registration."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,16"/>

                            <!-- Service Actions Card -->
                            <Border Style="{StaticResource AcrylicCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="Nilesoft Shell Service Controls" Style="{StaticResource SectionHeadingStyle}"/>
                                    <WrapPanel>
                                        <Button Content="Register Shell (Admin)" Style="{StaticResource AcrylicPrimaryButtonStyle}"
                                                Command="{Binding RegisterShellCommand}" IsEnabled="{Binding HasShellExecutable}" Margin="0,0,8,6"/>
                                        <Button Content="Unregister Shell (Admin)" Style="{StaticResource AcrylicDangerButtonStyle}"
                                                Command="{Binding UnregisterShellCommand}" IsEnabled="{Binding HasShellExecutable}" Margin="0,0,8,6"/>
                                        <Button Content="Restart Explorer" Style="{StaticResource AcrylicSecondaryButtonStyle}"
                                                Command="{Binding RestartExplorerCommand}" Margin="0,0,8,6"/>
                                        <Button Content="Open Shell Folder" Style="{StaticResource AcrylicSecondaryButtonStyle}"
                                                Command="{Binding OpenFolderCommand}" Margin="0,0,8,6"/>
                                    </WrapPanel>
                                    <TextBlock Text="Note: Register / Unregister buttons activate when shell.exe is present in the selected directory."
                                               Style="{StaticResource SettingDescStyle}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Generated Code Preview -->
                            <Border Style="{StaticResource AcrylicCardStyle}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <TextBlock Text="Generated Script File" Style="{StaticResource SectionHeadingStyle}" Margin="0" VerticalAlignment="Center"/>
                                        <ComboBox HorizontalAlignment="Right" Width="220"
                                                  Style="{StaticResource AcrylicComboBoxStyle}"
                                                  ItemsSource="{Binding PreviewFiles}"
                                                  SelectedItem="{Binding SelectedPreviewFile}"/>
                                    </Grid>

                                    <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="12"
                                             Height="360"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource AcrylicTextBoxStyle}"
                                             Padding="12,10"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Persistent Bottom Acrylic Action Bar -->
            <Border Grid.Row="2"
                    Background="{DynamicResource FooterBrush}"
                    BorderBrush="{DynamicResource BorderBrushSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Status & Unsaved Dot -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{DynamicResource WarningBrush}"
                                 Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"
                                 ToolTip="You have unsaved changes"/>
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                 Fill="{DynamicResource SuccessBrush}"
                                 Visibility="{Binding HasUnsavedChanges, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Reload" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding ReloadCommand}" Margin="0,0,8,0"/>
                        <Button Content="Reset Defaults" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,8,0"/>
                        <Button Content="Restart Explorer" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding RestartExplorerCommand}" Margin="0,0,10,0"/>
                        <Button Content="Save Configuration" Style="{StaticResource AcrylicPrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Border>
</Window>
