<Window x:Class="Shell.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Shell.Configurator.Controls"
        Title="Nilesoft Shell"
        Width="980" Height="680"
        MinWidth="820" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" Background="{StaticResource WindowTintBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Minimal Clean Title Bar: App Icon + Name on Left, 3 Windows Buttons on Right -->
            <Border Grid.Row="0"
                    Background="{StaticResource TitleBarBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="5" Background="{StaticResource AccentSoftBrush}" Margin="0,0,9,0">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nilesoft Shell"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" Click="MaxRestore_Click" ToolTip="Maximize"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== MAIN APP SHELL ==================== -->
            <Grid Grid.Row="1" Visibility="{Binding IsSetupVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="196"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Clean Left Sidebar -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SidebarBrush}"
                            BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="0,0,1,0"
                            Padding="10,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Key}"
                                                Click="NavCategory_Click"
                                                Cursor="Hand"
                                                Margin="0,0,0,3"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="NavBd"
                                                            CornerRadius="6"
                                                            Padding="9,8"
                                                            Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="26"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border x:Name="Indicator"
                                                                    Grid.Column="0"
                                                                    Width="3" Height="15"
                                                                    CornerRadius="1.5"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    Visibility="Collapsed"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"/>

                                                            <TextBlock x:Name="NavGlyph"
                                                                       Grid.Column="1"
                                                                       Text="{Binding Glyph}"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="13.5"
                                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock x:Name="NavLabel"
                                                                       Grid.Column="2"
                                                                       Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="4,0,4,0"/>

                                                            <TextBlock Grid.Column="3"
                                                                       Text="Off"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource TextMutedBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NavBd" Property="Background" Value="{StaticResource CardBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="NavBd" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="NavGlyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                            <Setter TargetName="NavLabel" Property="FontWeight" Value="SemiBold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                            <Setter TargetName="NavLabel" Property="Opacity" Value="0.55"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Clean Content Pane -->
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,18,24,18">
                        <Grid MaxWidth="740" HorizontalAlignment="Stretch">

                            <!-- ==================== SETTINGS ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Settings}">
                                <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}"/>
                                <TextBlock Text="Config folder, portable mode, shell registration, and global shell.nss options."
                                           Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,8"/>

                                <TextBlock Text="Portable &amp; Config Location" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border Style="{StaticResource AcrylicGroupStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="Active Folder" Style="{StaticResource SettingLabelStyle}"/>
                                                <TextBlock Text="{Binding ShellDirectory}" Style="{StaticResource SettingDescStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ShellDirectory}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="Open Folder" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding OpenFolderCommand}" Margin="0,0,6,0"/>
                                                <Button Content="Import / Setup" Style="{StaticResource AcrylicPrimaryButtonStyle}" Command="{Binding OpenSetupCommand}"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding PreservedImportsSummary}"
                                                   FontSize="11.5"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   Margin="0,8,0,0"
                                                   Visibility="{Binding PreservedImportsSummary, Converter={StaticResource NullToCollapsedConverter}}"/>

                                        <Border Style="{StaticResource RowDividerStyle}" Margin="0,12,0,10"/>

                                        <WrapPanel>
                                            <Button Content="Register Shell" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding RegisterShellCommand}" IsEnabled="{Binding HasShellExecutable}" Margin="0,0,8,0"/>
                                            <Button Content="Unregister Shell" Style="{StaticResource AcrylicDangerButtonStyle}" Command="{Binding UnregisterShellCommand}" IsEnabled="{Binding HasShellExecutable}" Margin="0,0,8,0"/>
                                            <Button Content="Restart Explorer" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding RestartExplorerCommand}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="General" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border Style="{StaticResource AcrylicGroupStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <Grid>
                                                <TextBlock Text="Show Delay" Style="{StaticResource SettingLabelStyle}"/>
                                                <TextBlock Text="{Binding Config.General.ShowDelay, StringFormat={}{0} ms}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True"
                                                    Value="{Binding Config.General.ShowDelay}" Margin="0,8,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Language" Style="{StaticResource SettingLabelStyle}"/>
                                            <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,6,0,0"
                                                      ItemsSource="{Binding AvailableLanguages}" SelectedItem="{Binding Config.General.Language}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Priority" Style="{StaticResource SettingLabelStyle}"/>
                                            <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,6,0,0"
                                                     Text="{Binding Config.General.Priority, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource AcrylicListGroupStyle}">
                                    <StackPanel>
                                        <ctrl:ToggleSettingCard Title="Explorer only" Description="Exclude non-Explorer processes (!process.is_explorer)" IsChecked="{Binding Config.General.ExcludeNonExplorer}"/>
                                        <ctrl:ToggleSettingCard Title="Remove duplicates" Description="Hide duplicate system menu entries" IsChecked="{Binding Config.General.RemoveDuplicates}"/>
                                        <ctrl:ToggleSettingCard Title="Tooltips" Description="Show hover hints on menu items" IsChecked="{Binding Config.General.TipsEnabled}"/>
                                        <ctrl:ToggleSettingCard Title="Pin / Unpin menu" Description="Include the Pin/Unpin submenu container" IsChecked="{Binding Config.General.EnablePinUnpinMenu}"/>
                                        <ctrl:ToggleSettingCard Title="More options menu" Description="Include the More options submenu container" IsChecked="{Binding Config.General.EnableMoreOptionsMenu}" IsLast="True"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Modules" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border Style="{StaticResource AcrylicGroupStyle}">
                                    <UniformGrid Columns="2">
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Theme (theme.nss)" IsChecked="{Binding Config.General.EnableThemeImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Icons (images.nss)" IsChecked="{Binding Config.General.EnableImagesImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Modify (modify.nss)" IsChecked="{Binding Config.General.EnableModifyImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Terminal (terminal.nss)" IsChecked="{Binding Config.General.EnableTerminalImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="File Manage (file-manage.nss)" IsChecked="{Binding Config.General.EnableFileManageImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Develop (develop.nss)" IsChecked="{Binding Config.General.EnableDevelopImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Go To (goto.nss)" IsChecked="{Binding Config.General.EnableGotoImport}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Taskbar (taskbar.nss)" IsChecked="{Binding Config.General.EnableTaskbarImport}"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== THEME ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Theme}">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Theme" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Context menu appearance in imports/theme.nss." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Content="Enabled"
                                              Style="{StaticResource AcrylicToggleSwitchStyle}" IsChecked="{Binding Config.General.EnableThemeImport}"/>
                                </Grid>

                                <Border Style="{StaticResource AcrylicGroupStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="12"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0">
                                            <TextBlock Text="Name" Style="{StaticResource SettingLabelStyle}"/>
                                            <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Config.Theme.Name}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="2">
                                            <TextBlock Text="Dark Mode" Style="{StaticResource SettingLabelStyle}"/>
                                            <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0" ItemsSource="{Binding DarkModeOptions}" SelectedItem="{Binding Config.Theme.DarkMode}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="4">
                                            <TextBlock Text="View" Style="{StaticResource SettingLabelStyle}"/>
                                            <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0" ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding Config.Theme.View}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0">
                                            <TextBlock Text="Background Effect" Style="{StaticResource SettingLabelStyle}"/>
                                            <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0" ItemsSource="{Binding EffectOptions}" SelectedItem="{Binding Config.Theme.BackgroundEffect}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="2">
                                            <TextBlock Text="Background Color" Style="{StaticResource SettingLabelStyle}"/>
                                            <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0" Text="{Binding Config.Theme.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="4">
                                            <Grid>
                                                <TextBlock Text="Image Align" Style="{StaticResource SettingLabelStyle}"/>
                                                <TextBlock Text="{Binding Config.Theme.ImageAlign}" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                            </Grid>
                                            <Slider Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,9,0,0" Value="{Binding Config.Theme.ImageAlign}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource AcrylicListGroupStyle}">
                                    <StackPanel>
                                        <ctrl:ToggleSettingCard Title="Auto opacity" Description="Let Shell decide menu background transparency" IsChecked="{Binding Config.Theme.UseAutoOpacity}"/>
                                        <Grid Margin="0,8,0,10" Visibility="{Binding Config.Theme.UseAutoOpacity, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="44"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Opacity" Style="{StaticResource SettingDescStyle}" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Config.Theme.BackgroundOpacity}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Config.Theme.BackgroundOpacity, StringFormat={}{0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                        </Grid>

                                        <ctrl:ToggleSettingCard Title="Border" Description="Menu outer border and corner radius" IsChecked="{Binding Config.Theme.BorderEnabled}"/>
                                        <Grid Margin="0,6,0,10" Visibility="{Binding Config.Theme.BorderEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Config.Theme.BorderRadius, StringFormat='Radius: {0}'}" Style="{StaticResource SettingDescStyle}"/>
                                                <Slider Minimum="0" Maximum="3" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.Theme.BorderRadius}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Config.Theme.BorderSize, StringFormat='Size: {0} px'}" Style="{StaticResource SettingDescStyle}"/>
                                                <Slider Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding Config.Theme.BorderSize}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <ctrl:ToggleSettingCard Title="Shadow" Description="Menu drop shadow" IsChecked="{Binding Config.Theme.ShadowEnabled}"/>
                                        <Grid Margin="0,6,0,10" Visibility="{Binding Config.Theme.ShadowEnabled, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="18"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Config.Theme.ShadowSize, StringFormat='Size: {0}'}" Style="{StaticResource SettingDescStyle}"/>
                                                <Slider Minimum="0" Maximum="30" Value="{Binding Config.Theme.ShadowSize}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Config.Theme.ShadowOpacity, StringFormat='Opacity: {0}%'}" Style="{StaticResource SettingDescStyle}"/>
                                                <Slider Minimum="0" Maximum="100" Value="{Binding Config.Theme.ShadowOpacity}" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <ctrl:ToggleSettingCard Title="Custom font" Description="Override default system font for menu text" IsChecked="{Binding Config.Theme.UseCustomFont}" IsLast="True"/>
                                        <Grid Margin="0,4,0,10" Visibility="{Binding Config.Theme.UseCustomFont, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Style="{StaticResource AcrylicTextBoxStyle}" Text="{Binding Config.Theme.FontName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="2" Style="{StaticResource AcrylicTextBoxStyle}" Text="{Binding Config.Theme.FontSize, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== MODIFY ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Modify}">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Modify" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Hide or group native Windows items in imports/modify.nss." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Content="Enabled"
                                              Style="{StaticResource AcrylicToggleSwitchStyle}" IsChecked="{Binding Config.General.EnableModifyImport}"/>
                                </Grid>

                                <TextBlock Text="System Rules" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border Style="{StaticResource AcrylicListGroupStyle}">
                                    <StackPanel>
                                        <ctrl:ToggleSettingCard Title="Remove 'Restore previous versions'" IsChecked="{Binding Config.Modify.RemoveRestorePreviousVersions}"/>
                                        <ctrl:ToggleSettingCard Title="Remove 'Cast to Device'" IsChecked="{Binding Config.Modify.RemoveCastToDevice}"/>
                                        <ctrl:ToggleSettingCard Title="Promote 'Empty Recycle Bin' on Desktop" IsChecked="{Binding Config.Modify.PromoteEmptyRecycleBin}"/>
                                        <ctrl:ToggleSettingCard Title="Group Pin / Unpin items" IsChecked="{Binding Config.Modify.GroupPinUnpin}"/>
                                        <ctrl:ToggleSettingCard Title="Move 'Copy as path' to File Manage" IsChecked="{Binding Config.Modify.MoveCopyAsPathToFileManage}"/>
                                        <ctrl:ToggleSettingCard Title="Move 'Customize this folder' to File Manage" IsChecked="{Binding Config.Modify.MoveCustomizeFolderToFileManage}"/>
                                        <ctrl:ToggleSettingCard Title="Move native Terminal / PowerShell to Terminal" IsChecked="{Binding Config.Modify.MoveTerminalItemsToTerminal}" IsLast="True"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Move to 'More options'" Style="{StaticResource SectionHeadingStyle}"/>
                                <Border Style="{StaticResource AcrylicGroupStyle}">
                                    <UniformGrid Columns="2">
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Send to" IsChecked="{Binding Config.Modify.MoreSendTo}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Share" IsChecked="{Binding Config.Modify.MoreShare}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Create shortcut" IsChecked="{Binding Config.Modify.MoreCreateShortcut}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Set as desktop background" IsChecked="{Binding Config.Modify.MoreSetDesktopBackground}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Rotate left" IsChecked="{Binding Config.Modify.MoreRotateLeft}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Rotate right" IsChecked="{Binding Config.Modify.MoreRotateRight}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Map network drive" IsChecked="{Binding Config.Modify.MoreMapNetworkDrive}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Disconnect network drive" IsChecked="{Binding Config.Modify.MoreDisconnectNetworkDrive}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Format" IsChecked="{Binding Config.Modify.MoreFormat}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Eject" IsChecked="{Binding Config.Modify.MoreEject}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Give access to" IsChecked="{Binding Config.Modify.MoreGiveAccessTo}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Include in library" IsChecked="{Binding Config.Modify.MoreIncludeInLibrary}"/>
                                        <CheckBox Margin="0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Print" IsChecked="{Binding Config.Modify.MorePrint}"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- ==================== TERMINAL ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Terminal}">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Terminal" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Shell entries in imports/terminal.nss." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Content="Enabled"
                                              Style="{StaticResource AcrylicToggleSwitchStyle}" IsChecked="{Binding Config.General.EnableTerminalImport}"/>
                                </Grid>

                                <Border Style="{StaticResource AcrylicListGroupStyle}">
                                    <StackPanel>
                                        <ctrl:ToggleSettingCard Title="Shift / Right-Click for Administrator" Description="Run any terminal item elevated with a tooltip hint" IsChecked="{Binding Config.Terminal.EnableAdminModifier}"/>
                                        <ctrl:ToggleSettingCard Title="Command Prompt" Description="Open cmd.exe in the selected folder" IsChecked="{Binding Config.Terminal.CommandPrompt}"/>
                                        <ctrl:ToggleSettingCard Title="Windows PowerShell" Description="Open powershell.exe in the selected folder" IsChecked="{Binding Config.Terminal.WindowsPowerShell}"/>
                                        <ctrl:ToggleSettingCard Title="Windows Terminal" Description="Shown automatically when Windows Terminal is installed" IsChecked="{Binding Config.Terminal.WindowsTerminal}" IsLast="True"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== FILE MANAGE ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=FileManage}">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="File Manage" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="File utilities in imports/file-manage.nss." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Content="Enabled"
                                              Style="{StaticResource AcrylicToggleSwitchStyle}" IsChecked="{Binding Config.General.EnableFileManageImport}"/>
                                </Grid>

                                <Border Style="{StaticResource AcrylicListGroupStyle}">
                                    <StackPanel>
                                        <ctrl:ToggleSettingCard Title="Copy Path submenu" IsChecked="{Binding Config.FileManage.CopyPathMenu}"/>
                                        <Border Margin="0,0,0,8" Padding="10,6" Background="{StaticResource SubCardBrush}" CornerRadius="6"
                                                Visibility="{Binding Config.FileManage.CopyPathMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <UniformGrid Columns="2">
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Multiple paths" IsChecked="{Binding Config.FileManage.CopyMultiplePaths}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Full path" IsChecked="{Binding Config.FileManage.CopyFullPath}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Shortcut target" IsChecked="{Binding Config.FileManage.CopyShortcutTarget}"/>
