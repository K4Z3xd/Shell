<Window x:Class="Shell.Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:Shell.Configurator.Controls"
        Title="Nilesoft Shell Configurator"
        Width="1120" Height="740"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44"
                      CornerRadius="10"
                      GlassFrameThickness="-1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- Root Translucent Acrylic Tint Overlay -->
    <Border x:Name="RootBorder" Background="{DynamicResource WindowTintBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Custom Acrylic TitleBar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    BorderBrush="{DynamicResource BorderBrushSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App Identity -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE756;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nilesoft Shell Configurator"
                                   FontSize="13.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Border Margin="10,0,0,0"
                                Padding="7,2"
                                CornerRadius="4"
                                Background="{DynamicResource AccentSoftBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Text="ACRYLIC"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>

                    <!-- Shell Directory Quick Selector -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Border Background="{DynamicResource SubCardBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding ShellDirectory}"
                                           MaxWidth="360"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding ShellDirectory}"/>
                                <Button Content="Browse"
                                        Click="BrowseFolder_Click"
                                        Margin="10,0,0,0"
                                        Padding="8,2"
                                        FontSize="11.5"
                                        Style="{StaticResource AcrylicSecondaryButtonStyle}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Theme Switch & Window Captions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleAppThemeCommand}"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0,0,8,0"
                                Padding="10,4"
                                Style="{StaticResource AcrylicSecondaryButtonStyle}"
                                ToolTip="Switch between Dark Acrylic and Light Acrylic">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AppThemeGlyph}"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding AppThemeLabel}" FontSize="11.5" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Content="&#xE921;" Style="{StaticResource CaptionButtonStyle}" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="MaxRestoreBtn" Content="&#xE922;" Style="{StaticResource CaptionButtonStyle}" Click="MaxRestore_Click" ToolTip="Maximize"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Workspace: Navigation Rail + Category Content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Acrylic Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBrush}"
                        BorderBrush="{DynamicResource BorderBrushSubtle}"
                        BorderThickness="0,0,1,0"
                        Padding="12,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Quick Search Box -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBox Style="{StaticResource AcrylicTextBoxStyle}"
                                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="30,7,10,7"
                                     ToolTip="Jump to a context menu category"/>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                            <TextBlock Text="Jump to category..."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="30,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Category List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Categories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding Key}"
                                                Click="NavCategory_Click"
                                                Cursor="Hand"
                                                Margin="0,0,0,4"
                                                HorizontalContentAlignment="Stretch"
                                                Background="Transparent"
                                                BorderThickness="0">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="NavBd"
                                                            CornerRadius="8"
                                                            Padding="10,9"
                                                            Background="Transparent"
                                                            BorderThickness="1"
                                                            BorderBrush="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="4"/>
                                                                <ColumnDefinition Width="28"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Border x:Name="Indicator"
                                                                    Grid.Column="0"
                                                                    Width="3" Height="16"
                                                                    CornerRadius="2"
                                                                    Background="{DynamicResource AccentBrush}"
                                                                    Visibility="Collapsed"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Glyph}"
                                                                       FontFamily="{StaticResource IconFont}"
                                                                       FontSize="14"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       x:Name="NavGlyph"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Title}"
                                                                       FontSize="13"
                                                                       FontWeight="Medium"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="4,0,6,0"/>

                                                            <Border Grid.Column="3"
                                                                    Padding="6,2"
                                                                    CornerRadius="5"
                                                                    Background="{DynamicResource SubCardBrush}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Badge}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="NavBd" Property="Background" Value="{DynamicResource CardBrush}"/>
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="NavBd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                            <Setter TargetName="NavBd" Property="BorderBrush" Value="{DynamicResource BorderBrushSubtle}"/>
                                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                            <Setter TargetName="NavGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Tip Box at Bottom of Sidebar -->
                        <Border Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="11,9"
                                CornerRadius="8"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource BorderBrushSubtle}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Instant Reload Tip"
                                           FontSize="11.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Hold Ctrl + Right-Click in File Explorer after saving to reload Nilesoft Shell immediately."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Main Content Area -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="26,20,26,20">
                    <Grid MaxWidth="820" HorizontalAlignment="Stretch">

                        <!-- ==================== PAGE 1: GENERAL & MODULES ==================== -->
                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=General}">
                            <TextBlock Text="General &amp; Context Modules" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Control global shell.nss settings, localization, and enable or disable entire context menu categories."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,18"/>

                            <TextBlock Text="Global Behavior" Style="{StaticResource SectionHeadingStyle}"/>
                            <Border Style="{StaticResource AcrylicCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Menu Show Delay (ms)" Style="{StaticResource SettingLabelStyle}"/>
                                        <TextBlock Text="Delay before submenus expand (0 - 4000 ms)" Style="{StaticResource SettingDescStyle}"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="52"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="1000" TickFrequency="50" IsSnapToTickEnabled="True"
                                                    Value="{Binding Config.General.ShowDelay}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Config.General.ShowDelay, StringFormat={}{0} ms}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Menu Localization" Style="{StaticResource SettingLabelStyle}"/>
                                        <TextBlock Text="Language pack loaded from imports/lang/" Style="{StaticResource SettingDescStyle}"/>
                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}"
                                                  Margin="0,8,0,0"
                                                  ItemsSource="{Binding AvailableLanguages}"
                                                  SelectedItem="{Binding Config.General.Language}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Hook Priority" Style="{StaticResource SettingLabelStyle}"/>
                                        <TextBlock Text="Execution priority for shell hooks (default: 1)" Style="{StaticResource SettingDescStyle}"/>
                                        <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,8,0,0" Width="100" HorizontalAlignment="Left"
                                                 Text="{Binding Config.General.Priority, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ctrl:ToggleSettingCard Glyph="&#xE770;" Title="Explorer Only (Exclude Other Processes)"
                                                    Description="Sets exclude.where = !process.is_explorer so custom menus only affect File Explorer."
                                                    IsChecked="{Binding Config.General.ExcludeNonExplorer}"/>
                            <ctrl:ToggleSettingCard Glyph="&#xE8C8;" Title="Remove Duplicate Entries"
                                                    Description="Automatically hides duplicated items when modifying system context menus."
                                                    IsChecked="{Binding Config.General.RemoveDuplicates}"/>
                            <ctrl:ToggleSettingCard Glyph="&#xE946;" Title="Enable Tooltips"
                                                    Description="Display helpful hover tooltips on menu entries (e.g., Shift for Admin)."
                                                    IsChecked="{Binding Config.General.TipsEnabled}"/>
                            <ctrl:ToggleSettingCard Glyph="&#xE718;" Title="Pin / Unpin Submenu Container"
                                                    Description="Expose the top-level Pin/Unpin submenu group inside shell.nss."
                                                    IsChecked="{Binding Config.General.EnablePinUnpinMenu}"/>
                            <ctrl:ToggleSettingCard Glyph="&#xE712;" Title="More Options Submenu Container"
                                                    Description="Expose the top-level More options submenu used to keep secondary items tidy."
                                                    IsChecked="{Binding Config.General.EnableMoreOptionsMenu}"/>

                            <TextBlock Text="Active Context Categories (imports/*.nss)" Style="{StaticResource SectionHeadingStyle}" Margin="0,12,0,8"/>
                            <UniformGrid Columns="2">
                                <ctrl:ToggleSettingCard Margin="0,0,6,0" Glyph="&#xE790;" Title="Theme (theme.nss)" Description="Custom menu visual style &amp; backdrop" IsChecked="{Binding Config.General.EnableThemeImport}"/>
                                <ctrl:ToggleSettingCard Margin="6,0,0,0" Glyph="&#xEB9F;" Title="SVG Icons (images.nss)" Description="Built-in vector icon definitions" IsChecked="{Binding Config.General.EnableImagesImport}"/>
                                <ctrl:ToggleSettingCard Margin="0,0,6,0" Glyph="&#xE70F;" Title="Modify System (modify.nss)" Description="Hide or reorganize native Windows entries" IsChecked="{Binding Config.General.EnableModifyImport}"/>
                                <ctrl:ToggleSettingCard Margin="6,0,0,0" Glyph="&#xE756;" Title="Terminal (terminal.nss)" Description="CMD, PowerShell, and Windows Terminal" IsChecked="{Binding Config.General.EnableTerminalImport}"/>
                                <ctrl:ToggleSettingCard Margin="0,0,6,0" Glyph="&#xE8B7;" Title="File Manage (file-manage.nss)" Description="Copy path, attributes, ownership, new items" IsChecked="{Binding Config.General.EnableFileManageImport}"/>
                                <ctrl:ToggleSettingCard Margin="6,0,0,0" Glyph="&#xE943;" Title="Develop (develop.nss)" Description="VS Code, Notepad, dotnet CLI, dev tools" IsChecked="{Binding Config.General.EnableDevelopImport}"/>
                                <ctrl:ToggleSettingCard Margin="0,0,6,0" Glyph="&#xE72A;" Title="Go To (goto.nss)" Description="Quick folders, Control Panel, Settings" IsChecked="{Binding Config.General.EnableGotoImport}"/>
                                <ctrl:ToggleSettingCard Margin="6,0,0,0" Glyph="&#xE75B;" Title="Taskbar (taskbar.nss)" Description="Taskbar apps, window layouts, Shell menu" IsChecked="{Binding Config.General.EnableTaskbarImport}"/>
                            </UniformGrid>
                        </StackPanel>

                        <!-- ==================== PAGE 2: THEME & ACRYLIC ==================== -->
                        <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Theme}">
                            <TextBlock Text="Theme &amp; Context Menu Acrylic" Style="{StaticResource PageTitleStyle}"/>
                            <TextBlock Text="Customize imports/theme.nss — configure Acrylic backdrop, color scheme, spacing, borders, shadow, and typography."
                                       Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,18"/>

                            <!-- Live Visual Context Menu Preview -->
                            <Border Style="{StaticResource AcrylicCardStyle}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Live Context Menu Preview" Style="{StaticResource SectionHeadingStyle}"/>
                                        <TextBlock Text="Adjusting Theme Preset, Backdrop Effect, Dark Mode, Border Radius, and Categories updates your generated imports/theme.nss automatically."
                                                   Style="{StaticResource SettingDescStyle}"/>
                                        <WrapPanel Margin="0,12,0,0">
                                            <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="6" Padding="9,4" Margin="0,0,8,6">
                                                <TextBlock Text="{Binding Config.Theme.Name, StringFormat=Preset: {0}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SubCardBrush}" CornerRadius="6" Padding="9,4" Margin="0,0,8,6">
                                                <TextBlock Text="{Binding Config.Theme.BackgroundEffect, StringFormat=Effect: {0}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                            <Border Background="{DynamicResource SubCardBrush}" CornerRadius="6" Padding="9,4" Margin="0,0,8,6">
                                                <TextBlock Text="{Binding Config.Theme.View, StringFormat=View: {0}}" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>

                                    <!-- Simulated Acrylic Context Menu Card -->
                                    <Border Grid.Column="1"
                                            Background="#B81B2230"
                                            BorderBrush="#3CFFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="6">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <Border CornerRadius="6" Padding="10,7" Background="#2E4CC2FF">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE756;" FontFamily="{StaticResource IconFont}" Foreground="#4CC2FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Terminal" Foreground="#F4F7FB" FontSize="12.5" FontWeight="Medium"/>
                                                    </StackPanel>
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#A6B2C6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="6" Padding="10,7" Visibility="{Binding Config.General.EnableFileManageImport, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" Foreground="#A6B2C6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="File manage" Foreground="#F4F7FB" FontSize="12.5"/>
                                                    </StackPanel>
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#A6B2C6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="6" Padding="10,7" Visibility="{Binding Config.General.EnableDevelopImport, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE943;" FontFamily="{StaticResource IconFont}" Foreground="#A6B2C6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Develop" Foreground="#F4F7FB" FontSize="12.5"/>
                                                    </StackPanel>
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#A6B2C6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border Height="1" Background="#1FFFFFFF" Margin="8,4"/>
                                            <Border CornerRadius="6" Padding="10,7" Visibility="{Binding Config.General.EnableGotoImport, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" Foreground="#A6B2C6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Go to" Foreground="#F4F7FB" FontSize="12.5"/>
                                                    </StackPanel>
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#A6B2C6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <Border CornerRadius="6" Padding="10,7" Visibility="{Binding Config.General.EnableMoreOptionsMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE712;" FontFamily="{StaticResource IconFont}" Foreground="#A6B2C6" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="More options" Foreground="#F4F7FB" FontSize="12.5"/>
                                                    </StackPanel>
                                                    <TextBlock Text="&#xE76C;" FontFamily="{StaticResource IconFont}" FontSize="10" Foreground="#A6B2C6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource AcrylicCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="14"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <TextBlock Text="Theme Preset" Style="{StaticResource SettingLabelStyle}"/>
                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,6,0,0"
                                                  ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Config.Theme.Name}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <TextBlock Text="Dark Mode" Style="{StaticResource SettingLabelStyle}"/>
                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,6,0,0"
                                                  ItemsSource="{Binding DarkModeOptions}" SelectedItem="{Binding Config.Theme.DarkMode}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="4">
                                        <TextBlock Text="Menu Density (View)" Style="{StaticResource SettingLabelStyle}"/>
                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,6,0,0"
                                                  ItemsSource="{Binding ViewOptions}" SelectedItem="{Binding Config.Theme.View}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="Backdrop Effect" Style="{StaticResource SettingLabelStyle}"/>
                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,6,0,0"
                                                  ItemsSource="{Binding EffectOptions}" SelectedItem="{Binding Config.Theme.BackgroundEffect}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <TextBlock Text="Background Color" Style="{StaticResource SettingLabelStyle}"/>
                                        <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,6,0,0"
                                                 Text="{Binding Config.Theme.BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Use 'auto' or a hex color like #1A202C"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="4">
                                        <TextBlock Text="Icon Alignment (0-2)" Style="{StaticResource SettingLabelStyle}"/>
                                        <Slider Minimum="0" Maximum="2" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Margin="0,10,0,0" Value="{Binding Config.Theme.ImageAlign}"/>
                                        <TextBlock Text="{Binding Config.Theme.ImageAlign, StringFormat='Mode: {0} (2 = Image + Check)'}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ctrl:ToggleSettingCard Glyph="&#xE793;" Title="Auto Background Opacity"
                                                    Description="Let Nilesoft Shell pick optimal transparency automatically (turn off to customize slider)."
                                                    IsChecked="{Binding Config.Theme.UseAutoOpacity}"/>

                            <Border Style="{StaticResource AcrylicCardStyle}"
                                    Visibility="{Binding Config.Theme.UseAutoOpacity, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Custom Background Opacity" Style="{StaticResource SettingLabelStyle}"/>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding Config.Theme.BackgroundOpacity}" Margin="0,8,0,0"/>
                                    </StackPanel>
