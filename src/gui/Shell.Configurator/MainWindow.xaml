                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Desktop" IsChecked="{Binding Config.Goto.FolderDesktop}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Downloads" IsChecked="{Binding Config.Goto.FolderDownloads}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Pictures" IsChecked="{Binding Config.Goto.FolderPictures}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Documents" IsChecked="{Binding Config.Goto.FolderDocuments}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Startmenu" IsChecked="{Binding Config.Goto.FolderStartMenu}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Profile" IsChecked="{Binding Config.Goto.FolderProfile}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="AppData" IsChecked="{Binding Config.Goto.FolderAppData}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Temp" IsChecked="{Binding Config.Goto.FolderTemp}"/>
                                            </UniformGrid>
                                        </Border>

                                        <ctrl:ToggleSettingCard Title="Control Panel" IsChecked="{Binding Config.Goto.ControlPanel}"/>
                                        <ctrl:ToggleSettingCard Title="All Control Panel Items" IsChecked="{Binding Config.Goto.AllControlPanelItems}"/>
                                        <ctrl:ToggleSettingCard Title="Run" IsChecked="{Binding Config.Goto.RunDialog}"/>
                                        <ctrl:ToggleSettingCard Title="Windows Settings submenu" IsChecked="{Binding Config.Goto.WindowsSettingsMenu}" IsLast="True"/>
                                        <Border Margin="0,0,0,10" Padding="10,6" Background="{StaticResource SubCardBrush}" CornerRadius="6"
                                                Visibility="{Binding Config.Goto.WindowsSettingsMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <UniformGrid Columns="2">
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="System / About / USB" IsChecked="{Binding Config.Goto.SettingsSystem}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Update &amp; Defender" IsChecked="{Binding Config.Goto.SettingsUpdateDefender}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Apps" IsChecked="{Binding Config.Goto.SettingsApps}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Personalization" IsChecked="{Binding Config.Goto.SettingsPersonalization}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Network" IsChecked="{Binding Config.Goto.SettingsNetwork}"/>
                                            </UniformGrid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== TASKBAR ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Taskbar}">
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Taskbar" Style="{StaticResource PageTitleStyle}"/>
