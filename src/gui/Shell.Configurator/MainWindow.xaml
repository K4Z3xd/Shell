                                    <StackPanel>
                                        <ctrl:ToggleSettingCard Title="Shell menu (Shift + Click)" Description="Quick access to config, manager, directory, and docs" IsChecked="{Binding Config.Taskbar.ShellAdminMenu}"/>
                                        <ctrl:ToggleSettingCard Title="Configurator shortcut in Shell menu" IsChecked="{Binding Config.Taskbar.IncludeConfiguratorShortcut}"/>
                                        <ctrl:ToggleSettingCard Title="Apps submenu" IsChecked="{Binding Config.Taskbar.AppsMenu}"/>
                                        <Border Margin="0,0,0,8" Padding="10,6" Background="{StaticResource SubCardBrush}" CornerRadius="6"
                                                Visibility="{Binding Config.Taskbar.AppsMenu, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <UniformGrid Columns="2">
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Paint" IsChecked="{Binding Config.Taskbar.AppPaint}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Edge" IsChecked="{Binding Config.Taskbar.AppEdge}"/>
                                                <CheckBox Margin="0,4" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Calculator" IsChecked="{Binding Config.Taskbar.AppCalculator}"/>
