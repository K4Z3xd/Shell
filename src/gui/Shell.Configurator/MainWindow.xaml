                                        <ctrl:ToggleSettingCard Title="Taskbar Settings" IsChecked="{Binding Config.Taskbar.TaskbarSettingsLink}"/>
                                        <ctrl:ToggleSettingCard Title="Restart Explorer (Shift)" IsChecked="{Binding Config.Taskbar.RestartExplorerOnShift}" IsLast="True"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- ==================== CUSTOM ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Custom}">
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Custom" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="User-defined entries in imports/user.nss." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="+ Add" Style="{StaticResource AcrylicPrimaryButtonStyle}" Command="{Binding AddCustomItemCommand}" Margin="0,0,6,0"/>
                                        <Button Content="Duplicate" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding DuplicateCustomItemCommand}" Margin="0,0,6,0"/>
                                        <Button Content="Delete" Style="{StaticResource AcrylicDangerButtonStyle}" Command="{Binding RemoveCustomItemCommand}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource AcrylicGroupStyle}" Padding="6" MinHeight="360">
                                        <Grid>
                                            <ListBox ItemsSource="{Binding Config.CustomItems}" SelectedItem="{Binding SelectedCustomItem}" Background="Transparent" BorderThickness="0">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="8,6"/>
                                                        <Setter Property="Margin" Value="0,0,0,3"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource SubCardBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding ContextType}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <CheckBox HorizontalAlignment="Right" Style="{StaticResource AcrylicToggleSwitchStyle}" IsChecked="{Binding Enabled}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="No custom items" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                                                       Visibility="{Binding HasCustomItems, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource AcrylicGroupStyle}" MinHeight="360">
                                        <Grid>
                                            <StackPanel Visibility="{Binding SelectedCustomItem, Converter={StaticResource NullToCollapsedConverter}}">
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Title" Style="{StaticResource SettingLabelStyle}"/>
                                                        <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0" Text="{Binding SelectedCustomItem.Title, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Type" Style="{StaticResource SettingLabelStyle}"/>
                                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0" ItemsSource="{Binding ContextTypeOptions}" SelectedItem="{Binding SelectedCustomItem.ContextType}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="140"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Submenu (optional)" Style="{StaticResource SettingLabelStyle}"/>
                                                        <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0" Text="{Binding SelectedCustomItem.Submenu, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Separator" Style="{StaticResource SettingLabelStyle}"/>
                                                        <ComboBox Style="{StaticResource AcrylicComboBoxStyle}" Margin="0,5,0,0" ItemsSource="{Binding SeparatorOptions}" SelectedItem="{Binding SelectedCustomItem.Separator}"/>
                                                    </StackPanel>
                                                </Grid>

                                                <TextBlock Text="Command" Style="{StaticResource SettingLabelStyle}"/>
                                                <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,10" Text="{Binding SelectedCustomItem.Command, UpdateSourceTrigger=PropertyChanged}"/>

                                                <TextBlock Text="Arguments" Style="{StaticResource SettingLabelStyle}"/>
                                                <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,10" Text="{Binding SelectedCustomItem.Arguments, UpdateSourceTrigger=PropertyChanged}"/>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Image / Icon" Style="{StaticResource SettingLabelStyle}"/>
                                                        <TextBox Style="{StaticResource AcrylicTextBoxStyle}" Margin="0,5,0,0" Text="{Binding SelectedCustomItem.Icon, UpdateSourceTrigger=PropertyChanged}"/>
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,5" Style="{StaticResource AcrylicToggleSwitchStyle}" Content="Admin" IsChecked="{Binding SelectedCustomItem.RunAsAdmin}"/>
                                                </Grid>
                                            </StackPanel>

                                            <TextBlock Text="Select an item to edit." VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedCustomItem}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- ==================== SCRIPT PREVIEW ==================== -->
                            <StackPanel Visibility="{Binding SelectedPage, Converter={StaticResource EqualToVisibilityConverter}, ConverterParameter=Script}">
                                <Grid Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Script" Style="{StaticResource PageTitleStyle}"/>
                                        <TextBlock Text="Generated .nss files preview." Style="{StaticResource PageSubtitleStyle}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <ComboBox HorizontalAlignment="Right" VerticalAlignment="Center" Width="210"
                                              Style="{StaticResource AcrylicComboBoxStyle}"
                                              ItemsSource="{Binding PreviewFiles}"
                                              SelectedItem="{Binding SelectedPreviewFile}"/>
                                </Grid>

                                <Border Style="{StaticResource AcrylicGroupStyle}" Padding="10">
                                    <TextBox Text="{Binding PreviewContent, Mode=OneWay}"
                                             IsReadOnly="True"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="12"
                                             Height="460"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             HorizontalScrollBarVisibility="Auto"
                                             VerticalScrollBarVisibility="Auto"
                                             Style="{StaticResource AcrylicTextBoxStyle}"
                                             Padding="10,8"/>
                                </Border>
                            </StackPanel>

                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Clean Footer Bar -->
                <Border Grid.Row="1"
                        Background="{StaticResource FooterBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="16,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource WarningBrush}"
                                     Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" Fill="{StaticResource SuccessBrush}"
                                     Visibility="{Binding HasUnsavedChanges, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Reload" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding ReloadCommand}" Margin="0,0,8,0"/>
                            <Button Content="Reset" Style="{StaticResource AcrylicSecondaryButtonStyle}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,8,0"/>
                            <Button Content="Save" Style="{StaticResource AcrylicPrimaryButtonStyle}" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ==================== PORTABLE IMPORT / FRESH SETUP OVERLAY ==================== -->
            <Grid Grid.Row="1"
                  Visibility="{Binding IsSetupVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                  Margin="36,28">
                <StackPanel VerticalAlignment="Center" MaxWidth="760">
                    <TextBlock Text="Nilesoft Shell Setup" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Run portable directly from an existing config folder, or start with a fresh configuration."
                               Style="{StaticResource PageSubtitleStyle}" Margin="0,4,0,22"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Option 1: Import from Existing Folder (Portable) -->
                        <Border Grid.Column="0" Style="{StaticResource AcrylicGroupStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Import from Folder" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Load your existing shell.nss &amp; imports from an older or original Nilesoft Shell folder. Skips system installation."
                                           Style="{StaticResource SettingDescStyle}" Margin="0,4,0,14"/>

                                <TextBlock Text="Existing Config Folder" Style="{StaticResource SettingLabelStyle}"/>
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource AcrylicTextBoxStyle}" Text="{Binding ImportFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource AcrylicSecondaryButtonStyle}" Click="BrowseImportFolder_Click" Margin="6,0,0,0"/>
                                </Grid>

                                <CheckBox Style="{StaticResource AcrylicToggleSwitchStyle}"
                                          Content="Copy portable app into this folder"
                                          IsChecked="{Binding CopyAppToImportFolder}"
                                          Margin="0,0,0,16"/>

                                <Button Content="Import &amp; Launch Portable"
                                        Style="{StaticResource AcrylicPrimaryButtonStyle}"
                                        Command="{Binding CompleteImportCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>

                        <!-- Option 2: Start with Fresh Config -->
                        <Border Grid.Column="2" Style="{StaticResource AcrylicGroupStyle}" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Start with Fresh Config" FontSize="15.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Initialize a clean default configuration in the default portable folder or any directory you choose."
                                           Style="{StaticResource SettingDescStyle}" Margin="0,4,0,14"/>

                                <TextBlock Text="Target Folder" Style="{StaticResource SettingLabelStyle}"/>
                                <Grid Margin="0,6,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{StaticResource AcrylicTextBoxStyle}" Text="{Binding FreshFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="Browse" Style="{StaticResource AcrylicSecondaryButtonStyle}" Click="BrowseFreshFolder_Click" Margin="6,0,0,0"/>
                                </Grid>

                                <CheckBox Style="{StaticResource AcrylicToggleSwitchStyle}"
                                          Content="Copy portable binaries to folder"
                                          IsChecked="{Binding FreshCopyBinaries}"
                                          Margin="0,0,0,8"/>

                                <CheckBox Style="{StaticResource AcrylicToggleSwitchStyle}"
                                          Content="Register with Windows Explorer (Admin)"
                                          IsChecked="{Binding FreshRegisterShell}"
                                          Margin="0,0,0,14"/>

                                <Button Content="Create Fresh Config"
                                        Style="{StaticResource AcrylicSecondaryButtonStyle}"
                                        Command="{Binding CompleteFreshSetupCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Button Content="Cancel"
                            Style="{StaticResource AcrylicSecondaryButtonStyle}"
                            Command="{Binding CancelSetupCommand}"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0"
                            Visibility="{Binding CanCancelSetup, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
