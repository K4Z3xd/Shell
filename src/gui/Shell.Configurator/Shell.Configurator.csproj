<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>ShellConfigurator</AssemblyName>
    <RootNamespace>Shell.Configurator</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Nilesoft Shell Configurator</Product>
    <Description>Acrylic GUI Configurator for Nilesoft Shell context menu categories and appearance</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
